{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ztx",
            "args": ["notify", "--from-hook"],
            "timeout": 5,
            "statusMessage": "ztx: refresh title"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ztx",
            "args": ["notify", "--from-hook"],
            "timeout": 5,
            "statusMessage": "ztx: refresh title"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ztx",
            "args": ["notify", "--from-hook"],
            "timeout": 5,
            "statusMessage": "ztx: refresh title"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ztx",
            "args": ["notify", "--from-hook"],
            "timeout": 5,
            "statusMessage": "ztx: refresh title"
          }
        ]
      }
    ]
  }
}
